{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "ServiceFlow": "Host=localhost;Port=5432;Database=serviceflow;Username=serviceflow;Password=serviceflow"
  },
  "Jwt": {
    "Issuer": "serviceflow",
    "Audience": "serviceflow-clients",
    "SigningKey": "REPLACE_ME_WITH_A_LONG_SECRET_AT_LEAST_32_CHARACTERS_LONG",
    "AccessTokenLifetimeMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "AutoMigrate": true
  },
  "Seed": {
    "AdminEmail": "",
    "AdminPassword": "",
    "AdminFullName": "System Administrator"
  },
  "AllowedHosts": "*"
}
